<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MUN_Digital_Speaker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MUN_Digital_Speaker.styles.css" asp-append-version="true" />
</head>
<body>
    @if (((bool?)ViewData["HideNavbar"]).GetValueOrDefault() == false)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MUN Digital Speaker</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SpeakerOrder" asp-action="index">Speaker List</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Delegations" asp-action="Index">Admin Pannel</a>
                            </li>
                            @{#pragma warning disable CS8602}
                            @if (User.Identity.Name == null)
                            {
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="Login">Login</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="Logout">@await Component.InvokeAsync("GetCountryFromLogin")</a>
                                </li>
                            }
                            @{#pragma warning restore CS8602}
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @if (((bool?)ViewData["HideNavbar"]).GetValueOrDefault() == false)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - MUN_Digital_Speaker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
