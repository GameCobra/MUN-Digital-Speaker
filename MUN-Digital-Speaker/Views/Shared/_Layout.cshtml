<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MMUNx</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MUN_Digital_Speaker.styles.css" asp-append-version="true" />

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
</head>
<body>

    @{
        bool navbarVisable = !(((bool?)ViewData["HideNavbar"]).GetValueOrDefault());
    }

    @if (navbarVisable == true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">

                    <!-- Logo type text on left side of nav bar -->
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">

                        <img src="@Url.Content("~/images/Logo2.svg")"
                             alt="Logo"
                             height="25"
                             class="d-inline-block align-text-top" />

                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">

                            <!-- Navagation items -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="ViewAmendments">View Amendments</a>
                            </li>

                            @{
                                @inject DelegationLookup delLookup
                                #pragma warning disable CS8602
                                string? loggedInUser = await delLookup.GetCountryFromLogin(User.Identity.Name);
                                #pragma warning restore CS8602
                                bool isLoggedIn = loggedInUser != null ? true : false;
                                bool isAdmin = loggedInUser == "Admin" ? true : false;
                            }

                            @if (isAdmin)
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SpeakerOrder" asp-action="SpeakerOrderDashboard">Speaker Order Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Delegations" asp-action="Index">Admin Panel</a>
                            </li>
                            <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserInterface" asp-action="ViewAllAmmendments">View All Ammendments</a>
                            </li>
                            }

                            @if (!isLoggedIn)
                            {
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserAccountManager" asp-action="Login">Login</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item ms-auto">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserAccountManager" asp-action="Logout">@loggedInUser</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <!-- Typical -->
    @if (((bool?)ViewData["NoContainer"]).GetValueOrDefault() == false)
    {
        <div class="container">
            <main role="main" class="pb-3">
            @RenderBody()
            </main>
        </div>
    }

    <!-- Specific variation for the speaker order -->
    @if (((bool?)ViewData["NoContainer"]).GetValueOrDefault() == true)
    {
        <div>
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }


    @if (((bool?)ViewData["HideNavbar"]).GetValueOrDefault() == false)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - MUN_Digital_Speaker - <a asp-area="" asp-controller="Home" asp-action="Credits">Credits</a>
            </div>
        </footer>
    }
    @if (@ViewData["Message"] != null)
    {
        <div>@ViewData["Message"]</div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
