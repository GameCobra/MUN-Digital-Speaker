@{
    ViewData["Title"] = "Display";
    ViewData["HideNavbar"] = true;
    ViewData["NoContainer"] = true;
}

<style>
    .speakerOrder {
        width: fit-content; /* shrink to content width */
        margin: 0 auto; /* center horizontally */
        text-align: left; /* keep numbers aligned */
        list-style-position: outside;
        padding-left: 1.4em; /* controls number spacing */
    }

    .ammOrder {
        width: fit-content; /* shrink to content width */
        margin: 0 auto; /* center horizontally */
        text-align: left; /* keep numbers aligned */
        list-style-position: outside;
        padding-left: 1.4em; /* controls number spacing */
    }

    .Res {
        width: fit-content; /* shrink to content width */
        margin: 0 auto; /* center horizontally */
        text-align: left; /* keep numbers aligned */
        list-style-position: outside;
        padding-left: 1.4em; /* controls number spacing */
    }
</style>

<body style="background-color:black;"></body>
<script>
    async function fetchData() {
        const response = await fetch('/SpeakerOrder/SpeakerListAsJSON');
        const data = await response.json();

        const orderElement = document.getElementsByClassName("speakerOrder");
        orderElement[0].innerHTML = '';
        for (let i = 0; i < data.length; i++)
        {
            const item = document.createElement("li");
            item.innerHTML = data[i];
            orderElement[0].appendChild(item);
        }

        const response2 = await fetch('/SpeakerOrder/AmendmentListAsJSON');
        const data2 = await response2.json();

        const orderElement2 = document.getElementsByClassName("ammOrder");
        orderElement2[0].innerHTML = '';
        for (let i = 0; i < data2.length; i++)
        {
            const item2 = document.createElement("li");
            item2.innerHTML = data2[i];
            orderElement2[0].appendChild(item2);
        }

        const response3 = await fetch('/SpeakerOrder/ResolutionsAsJSON?councel=GEN');
        const data3 = await response3.json();

        const orderElement3 = document.getElementsByClassName("Res");
        orderElement3[0].innerHTML = '';
        for (let i = 0; i < data3.length; i++)
        {
            const item3 = document.createElement("li");
            item3.innerHTML = data3[i].name + ": " + data3[i].state;
            orderElement3[0].appendChild(item3);
        }


    }

    // refresh every 5 seconds
    setInterval(fetchData, 5000);
    fetchData(); // run once on page load
</script>

<div class="fs-4" style="color:white">
    <div class="container-fluid">
    <div class="row">

        <!-- Amendment order -->
        <div class="col-3 mx-0">
            <div class="fs-1 text-center"><b>Ammendments</b></div>
            <ol class="ammOrder" style="color:white"></ol>
        </div>
        
        <!-- Debater Order -->
        <div class="col-3 mx-0">
            <div class="fs-1 text-center"><b>Debators</b></div>
            <ol class="speakerOrder" style="color:white"></ol>
        </div>
        
        <!-- Resolution list -->
        <div class="col-6 text-center mx-0">
            <div class="fs-1 text-center"><b>Resolutions</b></div>
            <ul class="Res" style="color:white"></ul>
        </div>
    </div>
    </div>

</div>