@model IEnumerable<MUN_Digital_Speaker.Models.Delegation>

@{
    ViewData["Title"] = "Index";
    List<int>? DuplicitLogins = (List<int>?)@ViewData["DuplicitLogins"];
    List<string>? DuplicitContries = (List<string>?)@ViewData["DuplicitContries"];

}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
    <a asp-action="Upload">Upload File</a>
    <a asp-action="SetResolutionsToDefault">Set resolution states</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Login)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Key)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimesSpoken)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AmendmentPoints)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequestedToSpeak)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @if (DuplicitContries != null && DuplicitContries.Contains(item.Country))
                {
                    <a style="color: red;">
                        @Html.DisplayFor(modelItem => item.Country)
                    </a>
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.Country)
                }
            </td>
            <td>
                @if (DuplicitLogins != null && DuplicitLogins.Contains(item.Login))
                {
                    <a style="color: red;">
                    @Html.DisplayFor(modelItem => item.Login)
                    </a>
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.Login)
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Key)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TimesSpoken)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AmendmentPoints)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequestedToSpeak)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


@{
    //if (DuplicitLogins != null)
    //{
    //    <b style="color:red;">! The login '@hasDuplicitLogins' is shared by multiple instances !</b>
    //}
}
