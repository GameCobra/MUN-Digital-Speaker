@model MUN_Digital_Speaker.Models.SpeakRequest

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Welcome @ViewData["country"]</h1>
@{
    bool hasRequestedToSpeakGEN = (bool?)@ViewData["hasRequestedGEN"] ?? false;
    bool hasRequestedToSpeakECO = (bool?)@ViewData["hasRequestedECO"] ?? false;
    bool hasRequestedToSpeakENV = (bool?)@ViewData["hasRequestedENV"] ?? false;
    bool hasRequestedToSpeakHE = (bool?)@ViewData["hasRequestedHE"] ?? false;
    bool hasRequestedToSpeakSEC = (bool?)@ViewData["hasRequestedSEC"] ?? false;


    
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="SpeakRequest">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Login" value="@ViewData["login"]" />
            <input type="hidden" asp-for="Councel" value="GEN" />

            @if (hasRequestedToSpeakGEN == false)
            {
                <div class="form-group">
                    <input type="submit" value="Request To Speak - GA" class="btn btn-primary" />
                </div>
            }
            else
            {
                <input type="hidden" asp-for="IsRevoking" value="true" />

                <div class="form-group">
                    <input type="submit" value="Revoke Request - GA" class="btn btn-primary" />
                </div>
            }
        </form>
    </div>
</div>


