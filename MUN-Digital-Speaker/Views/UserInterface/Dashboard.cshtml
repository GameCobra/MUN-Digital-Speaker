@model MUN_Digital_Speaker.Models.SpeakRequest

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Welcome @ViewData["country"]</h1>
@{
    bool? hasRequestedToSpeak = (bool?)@ViewData["hasRequested"];
    
}
@if (hasRequestedToSpeak == false)
{
    <div class="row">
        <div class="col-md-4">
            <form asp-action="SpeakRequest">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Login" value="@ViewData["login"]"/>

                <div class="form-group">
                    <input type="submit" value="Request To Speak"  class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
}
@if (hasRequestedToSpeak == true)
{
    <div class="row">
        <div class="col-md-4">
            <form asp-action="SpeakRequest">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Login" value="@ViewData["login"]" />
                <input type="hidden" asp-for="IsRevoking" value="true" />

                <div class="form-group">
                    <input type="submit" value="Revoke Request" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
}