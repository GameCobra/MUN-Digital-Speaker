@model MUN_Digital_Speaker.Models.ResolutionDelegationViewModel
@{
}

@foreach (var item in Model.resolutions)
{
    string target = "#" + item.ID;

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9">

                <button class="btn btn-primary mb-2 w-100"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target=@target>
                    @item.Name
                </button>

                <div class="collapse" id=@item.ID>
                    <div class="card card-body">

                        <a href=@item.Link>(View as image)</a>
                        <br>
                        <a>@item.Text</a>
                        <br>

                        <!--
                        <div class="row">
                            <div class="col-md-4">
                                <form action="/UserInterface/SubmitAmmendment" method="post">
                                    <input type="text" name="change">
                                    <input type="hidden" name="resoltuionID" value=@item.ID />
                                    <button type="submit">Submit</button>
                                </form>
                            </div>
                        </div>
                        -->


                        <button type="button" class="btn btn-success col-md-3" data-bs-toggle="modal" data-bs-target=@("#" + "Popup" + item.ID)>Create Amendment</button>

                        <div class="modal fade" id=@("Popup" + item.ID) tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">@("Submit amendment for " + item.Name)</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form action="/UserInterface/SubmitAmmendment" method="post">

                                        <div class="modal-body">
                                                <div class="form-group">
                                                    <label for="clause-number" class="col-form-label">Clause Number:</label>
                                                    <input type="text" class="form-control" name="ClauseNumber">
                                                </div>
                                                <div class="form-group">
                                                    <label for="change" class="col-form-label">Details:</label>
                                                    <textarea class="form-control" name="change"></textarea>
                                                </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-primary">Submit</button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>






                        <br>
                        @foreach (var amendment in Model.delegation.amendments.FindAll(x => x.ResolutionID == item.ID))
                        {
                            <a>@(amendment.ClauseNumber + " --- " + amendment.Change)</a>
                        }


                    </div>
                </div>

            </div>
        </div>
    </div>
}

