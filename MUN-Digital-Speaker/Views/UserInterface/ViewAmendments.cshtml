@foreach (var item in Model.resolutions)
{
    string target = "#" + item.name;

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9">

                <button class="btn btn-primary mb-2 w-100"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target=@target>
                    @item.name
                </button>

                <div class="collapse" id=@item.name>
                    <div class="card card-body">
                        This is the collapsible text.
                        It spans most of the screen using Bootstrap’s grid.
                    </div>
                </div>

            </div>
        </div>
    </div>
}


<div class="row">
    <div class="col-md-4">
        <form action="/UserInterface/SubmitAmmendment" method="post">
            <input type="text" name="change">
            <button type="submit">Submit</button>
        </form>
    </div>
</div>