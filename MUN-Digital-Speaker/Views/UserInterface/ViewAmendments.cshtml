@foreach (var item in Model.resolutions)
{
    string target = "#" + item.ID;

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9">

                <button class="btn btn-primary mb-2 w-100"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target=@target>
                    @item.Name
                </button>

                <div class="collapse" id=@item.ID>
                    <div class="card card-body">
                        <a href=@item.Link>(View as image)</a>
                        <br>
                        <a>@item.Text</a>
                        <br>

                        <div class="row">
                            <div class="col-md-4">
                                <form action="/UserInterface/SubmitAmmendment" method="post">
                                    <input type="text" name="change">
                                    <input type="hidden" name="resoltuionID" value=@item.ID />
                                    <button type="submit">Submit</button>
                                </form>
                            </div>
                        </div>


                    </div>
                </div>

            </div>
        </div>
    </div>
}

